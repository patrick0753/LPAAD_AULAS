    "def registrar_evento(origem,*recursos):\n",
    "    print(f'origem: {origem}')\n",
    "    for recurso in recursos:\n",
    "        print(f'recurso: {recurso}')\n",
    "\n",
    "registrar_evento(\n",
    "    'servidor', 'CPU', 'Memória', 'Disco'\n",
    ")"
   ]
